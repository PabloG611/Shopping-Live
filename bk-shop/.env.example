# ============================================================================
# bk-shop (Shopping Live) — plantilla de variables de entorno
# Copia este archivo como .env y ajusta los valores. NO subas .env al repo.
# ============================================================================

# --- Núcleo ---
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ENVIRONMENT=dev
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Bogota

# --- Base de datos PostgreSQL ---
DATABASE_NAME=shopping_live
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis (cache + channels + celery) ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- CORS (orígenes de los frontends web) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True

# --- Correo (en dev usa consola) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@shopping.live
