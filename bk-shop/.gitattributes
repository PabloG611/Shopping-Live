# Asegurar que los scripts de shell usen LF (Linux)
*.sh text eol=lf

# Asegurar que los archivos de Python usen LF
*.py text eol=lf

# Archivos de texto generales
*.txt text
*.md text
*.yml text
*.yaml text
*.json text

# Archivos binarios
*.dll binary
